{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_intent_os": {
    "intent_id": "12a64873-84f3-4161-b24b-eacd2ba87d41",
    "version": 1,
    "_do_not_edit": "Generated by intent-os harness. Edits override on next bundle pull."
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash|MultiEdit",
        "hooks": [{"type":"command","command":"bash .controlplane/hooks/pretooluse.sh","timeout":10}]
      }
